<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true"
    android:padding="8dp">

    <!-- Верхняя часть: циферблат, снизу — большая цифра. Не пересекаются. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.alexvahabov.nlsmeter.CircleView
            android:id="@+id/circleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />   <!-- было 0dp + weight=1 -->

        <com.alexvahabov.nlsmeter.BigTextView
            android:id="@+id/bigtextView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/black"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Строка «Work time + GPS» внизу, поверх -->
    <com.alexvahabov.nlsmeter.NumberView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom" />

    <!-- «GO!» поверх всего, исчезает после анимации -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/go"
        android:textColor="#dc362e"
        android:textSize="192dp" />

    <!-- Кнопка настроек поверх циферблата, с областью нажатия 48dp. -->
    <TextView
        android:id="@+id/settingsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/scale_settings"
        android:focusable="true"
        android:gravity="center"
        android:text="&#8942;"
        android:textColor="@android:color/white"
        android:textSize="32sp" />
</FrameLayout>
